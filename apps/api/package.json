{
  "name": "@jingo/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/pricing/pricing.test.ts && node --require ts-node/register --test src/admin/admin.test.ts src/orders/orders.test.ts src/content/content.test.ts src/partners/partners.test.ts src/content/translations.test.ts",
    "test:credit-postgres": "node --require ts-node/register --test src/partners/credit-postgres.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "pg-mem": "^3.0.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0"
  }
}
